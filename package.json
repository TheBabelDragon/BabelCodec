{
  "name": "babelcodec",
  "version": "0.3.0",
  "description": "Universal encoding, decoding, byte/packet inspector, and Boolean logic engine — offline-first",
  "type": "module",
  "main": "src/api/babelcodec.js",
  "exports": {
    ".": "./src/api/babelcodec.js",
    "./core": "./src/core/index.js",
    "./logic": "./src/logic/index.js"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js tests/logic/**/*.test.js",
    "test:core": "node --test tests/core.test.js",
    "test:logic": "node --test tests/logic/**/*.test.js",
    "build": "node scripts/build.js",
    "validate": "node --test tests/**/*.test.js tests/logic/**/*.test.js && node scripts/build.js"
  },
  "keywords": [
    "encoding",
    "decoding",
    "binary",
    "hex",
    "base64",
    "utf8",
    "inspector",
    "logic",
    "bitwise",
    "boolean",
    "babeldragon"
  ],
  "author": "TheBabelDragon",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
