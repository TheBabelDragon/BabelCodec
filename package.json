{
  "name": "babelcodec",
  "version": "0.10.0",
  "description": "Universal encoding, Unicode text, Neural Signal Contract, Morse, Boolean logic, interactive SHA-256 computer, educational CPU, and image generation workstation — offline-first",
  "type": "module",
  "main": "src/api/babelcodec.js",
  "exports": {
    ".": "./src/api/babelcodec.js",
    "./core": "./src/core/index.js",
    "./logic": "./src/logic/index.js",
    "./sha256": "./src/sha256/index.js",
    "./computer": "./src/computer/index.js",
    "./cpu": "./src/cpu/index.js",
    "./text": "./src/text/index.js",
    "./neural": "./src/neural/index.js",
    "./scripts": "./src/scripts/index.js",
    "./morse": "./src/codecs/morse/index.js",
    "./media": "./src/media/heif/index.js",
    "./media/image": "./src/media/image/index.js",
    "./media/studio": "./src/media/studio/index.js",
    "./media/generation": "./src/media/generation/index.js"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js tests/logic/**/*.test.js tests/sha256/**/*.test.js tests/computer/**/*.test.js tests/cpu/**/*.test.js tests/text/**/*.test.js tests/scripts/**/*.test.js tests/morse/**/*.test.js tests/digest/**/*.test.js tests/computer/architecture/**/*.test.js tests/media/**/*.test.js tests/ui/**/*.test.js tests/neural/**/*.test.js",
    "test:core": "node --test tests/core.test.js",
    "test:logic": "node --test tests/logic/**/*.test.js",
    "test:sha256": "node --test tests/sha256/**/*.test.js",
    "test:computer": "node --test tests/computer/**/*.test.js tests/computer/architecture/**/*.test.js",
    "test:cpu": "node --test tests/cpu/**/*.test.js",
    "test:text": "node --test tests/text/**/*.test.js tests/scripts/**/*.test.js tests/morse/**/*.test.js tests/digest/**/*.test.js",
    "test:neural": "node --test tests/neural/**/*.test.js",
    "test:media": "node --test tests/media/**/*.test.js",
    "test:ui": "node --test tests/ui/**/*.test.js",
    "test:rust": "cd rust && cargo test -p unicode-core",
    "build:wasm": "node scripts/build-wasm.js",
    "build": "node scripts/build.js",
    "validate": "npm test && npm run build"
  },
  "keywords": ["encoding", "unicode", "neural", "signal", "contract", "wasm", "rust", "morse", "sha256", "cpu", "workbench", "offline", "heif", "heic", "image", "generation"],
  "license": "MIT"
}
