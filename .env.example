# BabelCodec Image Generation Gateway — example environment
# Copy to services/generation-gateway/.env (gitignored) or your host secrets store.
# NEVER put real credentials in the repository or in browser JavaScript.

# Listen port
PORT=8787

# Comma-separated browser origins allowed to call the gateway
CORS_ORIGINS=https://thebabeldragon.github.io,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080

# Optional shared lab token (Bearer). Leave empty to rely on network isolation only.
GATEWAY_TOKEN=

# Optional upstream image API (server-side only)
# When unset, gateway returns a deterministic synthetic PNG (integration testing).
UPSTREAM_URL=
UPSTREAM_API_KEY=
UPSTREAM_TIMEOUT_MS=60000

# Limits
RATE_LIMIT_PER_MIN=30
MAX_PROMPT_CHARS=2000
MAX_DIMENSION=2048
