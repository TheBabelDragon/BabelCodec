{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebabeldragon.github.io/BabelCodec/schemas/media/detection-result.v1.schema.json",
  "title": "BabelCodec Detection Result v1",
  "type": "object",
  "required": ["schema", "byteLength", "findings", "alerts", "originalPreserved"],
  "properties": {
    "schema": { "const": "babelcodec.detection.v1" },
    "byteLength": { "type": "integer", "minimum": 0 },
    "sourceKind": { "type": ["string", "null"] },
    "filename": { "type": ["string", "null"] },
    "declaredMime": { "type": ["string", "null"] },
    "typeHint": { "type": ["string", "null"] },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "alerts": {
      "type": "array",
      "items": { "$ref": "#/$defs/alert" }
    },
    "limits": { "type": "object" },
    "originalPreserved": { "type": "boolean" }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["finding_id", "type", "confidence", "offset", "length", "completeness"],
      "properties": {
        "finding_id": { "type": "string" },
        "type": { "type": "string" },
        "subtype": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 },
        "source_representation": { "type": "string" },
        "completeness": {
          "type": "string",
          "enum": ["complete", "partial", "truncated", "malformed", "ambiguous", "unknown"]
        },
        "parent_finding_id": { "type": ["string", "null"] },
        "relationships": { "type": "array" },
        "warnings": { "type": "array" },
        "supported": { "type": "boolean" },
        "decoder_available": { "type": "boolean" },
        "alerts": { "type": "array", "items": { "$ref": "#/$defs/alert" } }
      }
    },
    "alert": {
      "type": "object",
      "required": ["level", "code", "message"],
      "properties": {
        "level": { "type": "string", "enum": ["info", "warning", "security", "unsupported"] },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "detail": {}
      }
    }
  }
}
